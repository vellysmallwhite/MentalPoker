# The lobby is discovery-only in v2. This image preserves the v1 server solely
# for the phase-one baseline.
ARG UBUNTU_IMAGE=ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

FROM ${UBUNTU_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG UBUNTU_SNAPSHOT=20260810T000000Z

RUN sed -ri \
        "s#https?://(archive.ubuntu.com/ubuntu|security.ubuntu.com/ubuntu|ports.ubuntu.com/ubuntu-ports)/?#https://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/#g" \
        /etc/apt/sources.list.d/ubuntu.sources \
    && printf '%s\n' \
        'Acquire::Check-Valid-Until "false";' \
        'Acquire::https::Verify-Peer "false";' \
        > /etc/apt/apt.conf.d/99snapshot-bootstrap \
    && apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm /etc/apt/apt.conf.d/99snapshot-bootstrap \
    && printf 'Acquire::Check-Valid-Until "false";\n' \
        > /etc/apt/apt.conf.d/99snapshot \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        python3=3.12.* \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 mentalpoker \
    && useradd --no-log-init --uid 10001 --gid 10001 \
        --home-dir /opt/mental-poker --shell /usr/sbin/nologin mentalpoker

LABEL org.opencontainers.image.title="MentalPoker legacy v1 lobby" \
      org.opencontainers.image.description="Test-only baseline lobby"

WORKDIR /opt/mental-poker

COPY --chown=10001:10001 src/server/server.py ./server.py

USER 10001:10001

HEALTHCHECK --interval=1s --timeout=2s --start-period=2s --retries=30 \
    CMD ["python3", "-c", "import os,socket; socket.create_connection((os.environ['HOSTNAME'],8080),2).close()"]

CMD ["python3", "-u", "server.py"]
